{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "",
    "watchPatterns": ["**/*.py", "requirements.txt"]
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "gunicorn -w 2 -k gthread -b 0.0.0.0:$PORT wsgi:app",
    "restartPolicyType": "ON_FAILURE",
    "sleepApplication": false
  }
}
